# Normalize text files to LF across Windows, WSL, and Linux
* text=auto eol=lf

# Keep Windows batch scripts as CRLF if added in the future
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.emf binary
