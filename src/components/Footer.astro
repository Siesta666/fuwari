---

import { profileConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();
const siteStartDate = siteConfig.siteStartDate || "2024-01-01";
---

<!--<div class="border-t border-[var(--primary)] mx-16 border-dashed py-8 max-w-[var(--page-width)] flex flex-col items-center justify-center px-6">-->
<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<!--<div class="transition bg-[oklch(92%_0.01_var(--hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6 py-4">
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a>

        <!-- 运行时间 -->
        <div class="text-xs text-black/60 dark:text-white/60 my-1.5 flex flex-wrap justify-center items-center gap-x-2 gap-y-1">
            <span id="runtime-container" class="inline-flex items-center">
                已运行 <span id="running-time" class="font-medium text-[var(--primary)] ml-1">--</span>
            </span>
        </div>

        <div>
            Powered by
            <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
            <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/Siesta666/fuwari">Fuwari</a>
        </div>
    </div>
</div>

<script define:vars={{ siteStartDate }}>
function updateRunningTime() {
    const startDate = new Date(siteStartDate);
    const now = new Date();
    const diff = now.getTime() - startDate.getTime();

    if (diff < 0) return;

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((diff / (1000 * 60)) % 60);
    const seconds = Math.floor((diff / 1000) % 60);

    const el = document.getElementById('running-time');
    if (el) {
        el.innerText = `${days}天 ${hours}小时 ${minutes}分 ${seconds}秒`;
    }
}

updateRunningTime();
if (!window.runtimeTimer) {
    window.runtimeTimer = setInterval(updateRunningTime, 1000);
}

document.addEventListener('swup:page:view', () => {
    updateRunningTime();
});
</script>